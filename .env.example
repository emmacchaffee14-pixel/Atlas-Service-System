# Supabase → Settings → Data API  (or the green "Connect" button)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Settings → API Keys → Publishable key (sb_publishable_...)
# This is the modern replacement for the old "anon" key. It is designed to
# ship in the browser bundle and is only safe because RLS is enabled with
# policies on every table — see supabase/schema.sql.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# The SECRET key (sb_secret_..., formerly service_role) does NOT belong here.
# It bypasses every policy in the schema. It goes in one place only:
# the invite-member Edge Function's secrets, set in the Supabase dashboard.
